# ParkSentry webapp — environment template.
# Copy this file to `.env` (which is gitignored) and fill in your Mappls keys.
#   cp .env.example .env
#
# Get keys by creating an app at https://apps.mappls.com (enable the Map SDK).
# The gateway mints a short-lived map token from the OAuth pair server-side, so
# the secret never reaches the browser. Without keys, everything except the
# interactive map still works.

MAPPLS_CLIENT_ID=your_client_id_here
MAPPLS_CLIENT_SECRET=your_client_secret_here
# Optional static Map SDK key fallback (used only if the OAuth pair is absent):
# MAPPLS_MAP_SDK_KEY=your_map_sdk_key_here

# Gateway / API wiring (single-port app on http://localhost:8000).
# Defaults already match these, so you only strictly need the Mappls keys above.
PORT=8000
API_URL=http://127.0.0.1:8001
